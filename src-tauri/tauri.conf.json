{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPA Desk",
  "identifier": "com.rafay.cpadesk",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CPA Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows",
        "backgroundThrottling": "disabled",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "version": "1.0.0",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCOUM4NTg1Q0Y2RjA2ODkKUldTSkJtL1BoWVdjdTZtQnVaL0xmRWZEM3VrWTVOZCt3QXdiZXJ5blBRNHVLRzRGL1QzT2NxSmwK",
      "endpoints": [
        "https://github.com/rafay99-epic/EasyCLIProxyAPI/releases/latest/download/latest.json"
      ]
    }
  }
}
